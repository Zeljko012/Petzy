# Slanje porudžbina mejlom preko Resend (https://resend.com). Bez ovoga se porudžbine samo snimaju u .data/porudzbine.
RESEND_API_KEY=
# Kome stižu porudžbine (može više adresa, odvojenih zarezom)
PORUDZBINE_EMAIL_ZA=
# Pošiljalac, sa domena verifikovanog u Resendu, npr. "Petzy porudžbine <porudzbine@petzy.rs>"
PORUDZBINE_EMAIL_OD=
# Opciono: drugi folder za snimanje porudžbina
# PORUDZBINE_FOLDER=
